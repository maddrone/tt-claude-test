; ── 按钮信号连接 ──────────────────────────────
[connection signal="pressed" from="MainMenuPanel/VBox/StartBtn" to="." method="_on_start_pressed"]
[connection signal="pressed" from="MainMenuPanel/VBox/HighScoreBtn" to="." method="_on_highscore_pressed"]
[connection signal="pressed" from="GameOverPanel/VBox/ReplayBtn" to="." method="_on_replay_pressed"]
[connection signal="pressed" from="GameOverPanel/VBox/MenuBtn" to="." method="_on_menu_pressed"]
