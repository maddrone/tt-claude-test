[gd_scene load_steps=2 format=2]

[ext_resource path="res://scripts/ui/GameUI.gd" type="Script" id=1]

[node name="GameUI" type="CanvasLayer"]
script = ExtResource( 1 )

; ── HUD (游戏中显示) ──────────────────────────
[node name="HUD" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0

; ── 顶部栏 ──────────────────────────────────
[node name="TopBar" type="HBoxContainer" parent="HUD"]
anchor_right = 1.0
margin_left = 15.0
margin_top = 10.0
margin_right = -15.0
margin_bottom = 100.0
custom_constants/separation = 10

; 分数面板
[node name="ScorePanel" type="VBoxContainer" parent="HUD/TopBar"]
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.2

[node name="BestLabel" type="Label" parent="HUD/TopBar/ScorePanel"]
text = "BEST"
align = 1

[node name="BestValue" type="Label" parent="HUD/TopBar/ScorePanel"]
text = "0"
align = 1

[node name="ScoreTitle" type="Label" parent="HUD/TopBar/ScorePanel"]
text = "SCORE"
align = 1

[node name="ScoreValue" type="Label" parent="HUD/TopBar/ScorePanel"]
text = "0"
align = 1

[node name="MultiplierLabel" type="Label" parent="HUD/TopBar/ScorePanel"]
text = "x1"
align = 1

; 时间条容器
[node name="TimerBarContainer" type="VBoxContainer" parent="HUD/TopBar"]
size_flags_horizontal = 3
size_flags_stretch_ratio = 2.0

[node name="TimerBar" type="ProgressBar" parent="HUD/TopBar/TimerBarContainer"]
margin_top = 15.0
rect_min_size = Vector2( 0, 24 )
value = 100.0
percent_visible = false

[node name="TimerLabel" type="Label" parent="HUD/TopBar/TimerBarContainer"]
text = "60s"
align = 1

; 暂停按钮
[node name="PauseBtn" type="Button" parent="HUD/TopBar"]
rect_min_size = Vector2( 50, 50 )
text = "||"

; ── 连击提示 ──────────────────────────────────
[node name="ComboLabel" type="Label" parent="HUD"]
anchor_left = 0.5
anchor_right = 0.5
margin_left = -150.0
margin_top = 180.0
margin_right = 150.0
margin_bottom = 230.0
text = ""
align = 1
valign = 1
rect_pivot_offset = Vector2( 150, 25 )

; ── 时间奖励提示 ──────────────────────────────
[node name="TimeBonusLabel" type="Label" parent="HUD"]
anchor_left = 0.5
anchor_right = 0.5
margin_left = -60.0
margin_top = 125.0
margin_right = 60.0
margin_bottom = 155.0
text = ""
align = 1
valign = 1
rect_pivot_offset = Vector2( 60, 15 )

; ── 道具栏 ──────────────────────────────────
[node name="PowerupBar" type="VBoxContainer" parent="HUD"]
anchor_left = 1.0
anchor_right = 1.0
margin_left = -70.0
margin_top = 450.0
margin_right = -5.0
margin_bottom = 650.0
custom_constants/separation = 10

[node name="ItemsLabel" type="Label" parent="HUD/PowerupBar"]
text = "ITEMS"
align = 1

[node name="HammerBtn" type="Button" parent="HUD/PowerupBar"]
rect_min_size = Vector2( 60, 60 )
text = "H"

[node name="CountLabel" type="Label" parent="HUD/PowerupBar/HammerBtn"]
anchor_right = 1.0
anchor_bottom = 1.0
text = "0"
align = 2
valign = 2

[node name="ShuffleBtn" type="Button" parent="HUD/PowerupBar"]
rect_min_size = Vector2( 60, 60 )
text = "S"

[node name="CountLabel" type="Label" parent="HUD/PowerupBar/ShuffleBtn"]
anchor_right = 1.0
anchor_bottom = 1.0
text = "0"
align = 2
valign = 2

; ── 主菜单面板 ──────────────────────────────
[node name="MainMenuPanel" type="Panel" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
